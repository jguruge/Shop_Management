# Shop Management API — environment configuration
#
# Copy to backend/.env (git-ignored) and fill in the blanks.
#
# How it is read:
#   • `dotnet run` (local): Program.cs loads backend/.env at start-up.
#   • Docker:               docker run --env-file backend/.env -p 8080:8080 shopmanagement-api
#
# appsettings*.json hold only logging; every environment-specific value and secret lives
# here (or in real environment variables, which always win over this file). Blank values are
# ignored. A double underscore "__" separates nested keys (Jwt__Key = Jwt:Key).

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ShopManagement;Username=postgres;Password=

# ── JWT authentication ──────────────────────────────────────────────────────
# Key: at least 32 random bytes, e.g. `openssl rand -base64 48`
Jwt__Key=
Jwt__Issuer=ShopManagement.Api
Jwt__Audience=ShopManagement.Client
Jwt__ExpiryMinutes=60

# ── CORS — web-app origins (__0, __1, …) ────────────────────────────────────
Cors__AllowedOrigins__0=http://localhost:5173

# ── First admin account (created on start-up in Development when Users is empty) ──
Seed__AdminEmail=admin@shop.local
Seed__AdminPassword=
